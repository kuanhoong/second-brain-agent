{
  "manifest_version": 3,
  "name": "Second Brain Capture",
  "version": "0.1.0",
  "description": "Highlight text on any page and send it to your local OKF second brain.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Save highlight to Second Brain", "default_popup": "popup.html",
              "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "capture-highlight": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the highlighted text to Second Brain"
    }
  }
}
