# Copy to `.env` and fill in. Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Use Google AI Studio (free tier), not Vertex AI:
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional: point the agent at a different vault
# VAULT_DIR=/absolute/path/to/my-second-brain
