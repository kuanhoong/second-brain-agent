# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional. Pin the exact model ID you rehearsed with.
# SECOND_BRAIN_MODEL=gemini-3.8-flash
# Your id for OKF's actor convention (reviews are recorded as human:<id>).
# SECOND_BRAIN_OWNER=kuanhoong
# Point the agent at another OKF bundle.
# VAULT_DIR=/absolute/path/to/vault
